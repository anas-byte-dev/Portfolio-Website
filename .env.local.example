# ==============================================================================
# Portfolio Contact Form Email Configuration
# ==============================================================================

# 1. Recipient Address
# The email address where you will receive messages from recruiters & visitors
CONTACT_EMAIL=anassidd7256@gmail.com

# 2. Gmail SMTP Delivery (Recommended, 100% Free)
# Steps to generate your 16-character Gmail App Password:
# 1. Open your Google Account settings: https://myaccount.google.com/
# 2. Go to "Security" and ensure "2-Step Verification" is turned ON.
# 3. Search for "App Passwords" in the search bar.
# 4. Under App name, type "Portfolio" and click "Create".
# 5. Copy the 16-character password and paste it into SMTP_PASS below (without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=anassidd7256@gmail.com
SMTP_PASS=your_16_character_gmail_app_password

# 3. (Alternative) Web3Forms Key (Zero setup needed)
# If you prefer using Web3Forms without a Gmail password, generate a free key at https://web3forms.com
# WEB3FORMS_ACCESS_KEY=
